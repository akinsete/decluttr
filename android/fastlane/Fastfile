# frozen_string_literal: true

default_platform(:android)

platform :android do
  def play_json_key_path
    raw = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_CREDENTIALS"].to_s
    if raw.strip.start_with?("{")
      path = File.expand_path("play-service-account.json", __dir__)
      File.write(path, raw)
      return path
    end
    ENV.fetch("SUPPLY_JSON_KEY") do
      UI.user_error!("Set GOOGLE_PLAY_SERVICE_ACCOUNT_CREDENTIALS (JSON) or SUPPLY_JSON_KEY (path)")
    end
  end

  desc "Upload Play listing metadata + screenshots (no AAB) from docs/store/google-play"
  lane :supply_listing do |options|
    skip_screenshots = options.fetch(:skip_screenshots, ENV["SKIP_PLAY_SCREENSHOT_UPLOAD"] == "true")

    upload_to_play_store(
      package_name: "com.ffslabs.decluttr",
      json_key: play_json_key_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: skip_screenshots,
      sync_image_upload: true,
      metadata_path: File.expand_path("metadata/android", __dir__),
      changes_not_sent_for_review: true
    )
  end

  desc "Metadata only (no screenshots)"
  lane :supply_metadata_only do
    supply_listing(skip_screenshots: true)
  end
end
