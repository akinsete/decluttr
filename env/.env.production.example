# Production — decluttr-becd5 (from GoogleService-Info.plist + google-services.json).
# Copy to env/.env.production (gitignored):
#   cp env/.env.production.example env/.env.production
#
# Flutter web / Windows / Linux also need FIREBASE_WEB_* from Firebase Console → Web app.
#
# Internal APKs (not from Play) often fail Play Integrity. For testing only:
# FIREBASE_APP_CHECK_USE_DEBUG_PROVIDER=true
# Then register the Android debug token from logcat in App Check.

FIREBASE_APP_CHECK_USE_DEBUG_PROVIDER=false

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_SIGN_IN_SERVER_CLIENT_ID=
