# Copy to .env.development and fill from your Firebase project (decluttr-becd5).
#
# If Cloud Functions / Firestore return 403 App Check errors on a non-debug
# build, set to true and register the printed debug token in Firebase Console
# → App Check → Manage debug tokens.
FIREBASE_APP_CHECK_USE_DEBUG_PROVIDER=true

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_SIGN_IN_SERVER_CLIENT_ID=
