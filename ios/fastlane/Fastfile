# frozen_string_literal: true

require_relative "lib/asc_store_automation"

default_platform(:ios)

platform :ios do
  def asc_api_key
    key_b64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_BASE64") if key_b64.to_s.strip.empty?

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: key_b64,
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  end

  desc "One-time: register bundle ID + create App Store Connect app"
  lane :setup_app_store do
    produce(
      api_key: asc_api_key,
      app_identifier: "com.ffslabs.decluttr",
      app_name: "Decluttr",
      sku: "decluttr-ios",
      language: "en-US",
      skip_itc: false,
      skip_devcenter: false
    )

    UI.success("Registered com.ffslabs.decluttr in Developer Portal and App Store Connect.")
    UI.important("Next: Codemagic → Team settings → Code signing → iOS → fetch App Store profile, then re-run CI.")
  end

  desc "Upload App Store listing metadata (+ screenshots) via deliver"
  lane :deliver_listing do |options|
    skip_screenshots = options.fetch(:skip_screenshots, ENV["SKIP_SCREENSHOT_UPLOAD"] == "true")

    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: skip_screenshots,
      force: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__)
    )
  end

  desc "Metadata only (no screenshots)"
  lane :deliver_metadata_only do
    deliver_listing(skip_screenshots: true)
  end

  desc "App Privacy nutrition labels from docs/store/app-store/app_privacy_details.json"
  lane :upload_privacy do
    AscStoreAutomation.sync_privacy!(
      skip_publish: ENV["SKIP_PRIVACY_PUBLISH"] == "true"
    )
  end

  desc "First-submit prep: content rights, free price, App Privacy"
  lane :prepare_first_submission do
    failures = []

    begin
      AscStoreAutomation.set_content_rights!(uses_third_party_content: false)
    rescue StandardError => e
      UI.error("Content rights failed: #{e.message}")
      failures << "content_rights"
    end

    begin
      AscStoreAutomation.set_free_price_schedule!
    rescue StandardError => e
      UI.error("Free price schedule failed: #{e.message}")
      failures << "pricing"
    end

    unless ENV["SKIP_PRIVACY_UPLOAD"] == "true"
      begin
        AscStoreAutomation.sync_privacy!(
          skip_publish: ENV["SKIP_PRIVACY_PUBLISH"] == "true"
        )
      rescue StandardError => e
        # Public ASC API no longer exposes app privacy nutrition labels (PATH_ERROR on
        # dataUsages / appDataUsages). An Account Holder/Admin must fill App Privacy in the web UI.
        if e.message.include?("PATH_ERROR") || e.message.include?("dataUsages") || e.message.include?("appDataUsages")
          UI.important("App Privacy API unavailable (#{e.message.split("\n").first}).")
          UI.important("Fill App Privacy in App Store Connect as Admin, then publish.")
        else
          UI.error("App Privacy sync failed: #{e.message}")
          failures << "privacy"
        end
      end
    end

    UI.user_error!("prepare_first_submission failed: #{failures.join(', ')}") unless failures.empty?
    UI.success("First-submit prep complete (content rights, pricing; privacy may need web UI).")
  end

  desc "Privacy extras + content rights + free pricing (CPP / intro offers skipped unless JSON is Decluttr-ready)"
  lane :sync_store_extras do
    failures = []

    begin
      AscStoreAutomation.set_content_rights!(uses_third_party_content: false)
    rescue StandardError => e
      UI.error("Content rights failed: #{e.message}")
      failures << "content_rights"
    end

    begin
      AscStoreAutomation.set_free_price_schedule!
    rescue StandardError => e
      UI.error("Free price schedule failed: #{e.message}")
      failures << "pricing"
    end

    unless ENV["SKIP_PRIVACY_UPLOAD"] == "true"
      begin
        AscStoreAutomation.sync_privacy!(
          skip_publish: ENV["SKIP_PRIVACY_PUBLISH"] == "true"
        )
      rescue StandardError => e
        UI.error("App Privacy sync failed: #{e.message}")
        failures << "privacy"
      end
    end

    # Decluttr v1: no IAP intro offers / CPP by default.
    if ENV["SKIP_INTRO_OFFERS"] != "true" && File.exist?(File.expand_path("../../../docs/store/app-store/intro-offers.json", __dir__))
      begin
        AscStoreAutomation.sync_intro_offers!
      rescue StandardError => e
        UI.error("Intro offers sync failed: #{e.message}")
        failures << "intro_offers"
      end
    end

    UI.user_error!("sync_store_extras failed: #{failures.join(', ')}") unless failures.empty?
  end
end
