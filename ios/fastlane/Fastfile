# frozen_string_literal: true

require_relative "lib/asc_store_automation"

default_platform(:ios)

platform :ios do
  def asc_api_key
    key_b64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY_BASE64") if key_b64.to_s.strip.empty?

    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: key_b64,
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  end

  desc "Upload App Store listing metadata (+ screenshots) via deliver"
  lane :deliver_listing do |options|
    skip_screenshots = options.fetch(:skip_screenshots, ENV["SKIP_SCREENSHOT_UPLOAD"] == "true")

    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: skip_screenshots,
      force: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__)
    )
  end

  desc "Metadata only (no screenshots)"
  lane :deliver_metadata_only do
    deliver_listing(skip_screenshots: true)
  end

  desc "App Privacy nutrition labels from docs/store/app-store/app_privacy_details.json"
  lane :upload_privacy do
    AscStoreAutomation.sync_privacy!(
      skip_publish: ENV["SKIP_PRIVACY_PUBLISH"] == "true"
    )
  end

  desc "Privacy extras (CPP / intro offers skipped unless JSON is Decluttr-ready)"
  lane :sync_store_extras do
    failures = []

    unless ENV["SKIP_PRIVACY_UPLOAD"] == "true"
      begin
        AscStoreAutomation.sync_privacy!(
          skip_publish: ENV["SKIP_PRIVACY_PUBLISH"] == "true"
        )
      rescue StandardError => e
        UI.error("App Privacy sync failed: #{e.message}")
        failures << "privacy"
      end
    end

    # Decluttr v1: no IAP intro offers / CPP by default.
    if ENV["SKIP_INTRO_OFFERS"] != "true" && File.exist?(File.expand_path("../../../docs/store/app-store/intro-offers.json", __dir__))
      begin
        AscStoreAutomation.sync_intro_offers!
      rescue StandardError => e
        UI.error("Intro offers sync failed: #{e.message}")
        failures << "intro_offers"
      end
    end

    UI.user_error!("sync_store_extras failed: #{failures.join(', ')}") unless failures.empty?
  end
end
